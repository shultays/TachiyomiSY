import kotlin.Boolean;

DROP TRIGGER IF EXISTS update_last_modified_at_mangas_categories;
ALTER TABLE mangas_categories DROP COLUMN last_modified_at;

DROP TRIGGER IF EXISTS system_category_delete_trigger;
CREATE TRIGGER system_category_delete_trigger BEFORE DELETE
ON categories
BEGIN SELECT CASE
    WHEN old._id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

CREATE TABLE extension_store(
    index_url TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    badge_label TEXT NOT NULL,
    signing_key TEXT NOT NULL,
    contact_website TEXT NOT NULL,
    contact_discord TEXT,
    is_legacy INTEGER AS Boolean NOT NULL
);

INSERT INTO extension_store(index_url, name, badge_label, signing_key, contact_website, contact_discord, is_legacy)
SELECT base_url || '/repo.json', name, coalesce(short_name, name), signing_key_fingerprint, website, NULL, 1 FROM extension_repos;

DROP TABLE extension_repos;

ALTER TABLE mangas ADD COLUMN memo BLOB NOT NULL DEFAULT '{}';
ALTER TABLE chapters ADD COLUMN memo BLOB NOT NULL DEFAULT '{}';
ALTER TABLE extension_store ADD COLUMN extension_list_url TEXT;
